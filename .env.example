# =============================================================================
# SmartHire AI — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the required values.
# NEVER commit .env to version control.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="SmartHire AI"
APP_ENV=development         # development | production | testing
DEBUG=true
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Local Docker:  postgresql+asyncpg://smarthire:smarthire@postgres:5432/smarthire_db
# Neon (prod):   postgresql+asyncpg://user:pass@ep-xxx.us-east-1.aws.neon.tech/smarthire_db?sslmode=require
DATABASE_URL=postgresql+asyncpg://smarthire:smarthire@localhost:5432/smarthire_db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local Docker:  redis://redis:6379/0
# Upstash:       redis://:password@host:port
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT=120
CELERY_TASK_TIME_LIMIT=180

# ── Cloudflare R2 (S3-Compatible File Storage — FREE) ──────────────────────────────────
# Free tier: 10 GB storage, 1M writes/mo, 10M reads/mo, zero egress fees
# Get credentials: Cloudflare Dashboard → R2 → Manage R2 API Tokens
#
# STORAGE_ENDPOINT_URL format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Your Account ID: Cloudflare Dashboard → right sidebar → Account ID
STORAGE_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your_r2_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
AWS_REGION=auto
AWS_S3_BUCKET_NAME=smarthire-ai

# Presigned URL expiry in seconds (default: 1 hour)
S3_PRESIGNED_URL_EXPIRY=3600

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── SentenceTransformers ──────────────────────────────────────────────────────
# Model is downloaded automatically on first run (~90 MB)
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Local Docker: chromadb (service name)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=5/minute

# =============================================================================
# Frontend Variables (.env.local in frontend/)
# =============================================================================
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_APP_NAME="SmartHire AI"

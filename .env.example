# =============================================================================
# SmartHire AI — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the required values.
# NEVER commit .env to version control.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="SmartHire AI"
APP_ENV=development         # development | production | testing
DEBUG=true
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Local Docker:  postgresql+asyncpg://smarthire:smarthire@postgres:5432/smarthire_db
# Supabase:      postgresql+asyncpg://postgres.<project-ref>:password@aws-0-region.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://smarthire:smarthire@localhost:5432/smarthire_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Optional Supabase API credentials. The backend currently connects directly through DATABASE_URL;
# these REST API values are not currently used by the backend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local Docker:  redis://redis:6379/0
# Upstash:       redis://:password@host:port
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT=120
CELERY_TASK_TIME_LIMIT=180

# ── Vercel Blob File Storage ──────────────────────────────────────────────────
# Use a private Blob store for resumes and generated reports.
# Get from: Vercel Dashboard → Storage → Blob → <your store> → Connect → Token
# Token format: vercel_blob_rw_xxxxxxxxxxxxxxxx
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── SentenceTransformers ──────────────────────────────────────────────────────
# Model is downloaded automatically on first run (~90 MB)
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Vector embeddings are stored in PostgreSQL via the pgvector extension.

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=5/minute

# =============================================================================
# Frontend Variables (.env.local in frontend/)
# =============================================================================
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_APP_NAME="SmartHire AI"
